{
  "name": "matsu-artifact-delivery-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.ts all",
    "test:contracts": "node scripts/run-tests.ts all --targets workflow,escalation,integration,infrastructure",
    "test:unit": "node scripts/run-tests.ts unit",
    "test:e2e": "node scripts/run-tests.ts e2e",
    "test:infrastructure": "node scripts/run-tests.ts unit --targets infrastructure",
    "test:workflow": "node scripts/run-tests.ts all --targets workflow",
    "test:workflow:unit": "node scripts/run-tests.ts unit --targets workflow",
    "test:workflow:e2e": "node scripts/run-tests.ts e2e --targets workflow",
    "test:escalation": "node scripts/run-tests.ts all --targets escalation",
    "test:escalation:unit": "node scripts/run-tests.ts unit --targets escalation",
    "test:escalation:e2e": "node scripts/run-tests.ts e2e --targets escalation",
    "test:integration": "node scripts/run-tests.ts e2e --targets integration",
    "test:mcp": "node scripts/run-tests.ts all --targets mcp",
    "ci:select": "node scripts/select-tests.ts",
    "format": "prettier --write \"scripts/**/*.ts\" \"test/**/*.ts\" \"test/**/*.json\" package.json tsconfig.json .oxlintrc.json .prettierrc.json AGENTS.md \".github/workflows/*.yml\" docs/testing.md docs/distribution.md",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"test/**/*.ts\" \"test/**/*.json\" package.json tsconfig.json .oxlintrc.json .prettierrc.json AGENTS.md \".github/workflows/*.yml\" docs/testing.md docs/distribution.md",
    "test:mcp:unit": "node scripts/run-tests.ts unit --targets mcp",
    "test:mcp:e2e": "node scripts/run-tests.ts e2e --targets mcp",
    "check:manifests": "node scripts/validate-manifests.ts && node scripts/sync-manifests.ts --check",
    "sync:manifests": "node scripts/sync-manifests.ts",
    "package": "npm run check:manifests && npm --prefix plugins/artifact-workflow run check:dist && node scripts/package-plugins.ts",
    "test:install": "node scripts/test-install.ts",
    "check": "npm run check:typescript && tsc --noEmit",
    "check:typescript": "node scripts/check-typescript.ts",
    "lint": "oxlint --type-aware --deny-warnings scripts test"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "github-slugger": "2.0.0",
    "marked": "18.0.14",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "smol-toml": "1.9.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
