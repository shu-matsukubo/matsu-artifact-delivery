{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["mcp/src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
