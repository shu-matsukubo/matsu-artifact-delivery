{
  "mcpServers": {
    "artifact-task-memory": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}/mcp/start.ps1"
      ],
      "env": {
        "ARTIFACT_WORKFLOW_DATA_DIR": "${PLUGIN_DATA}/task-memory"
      }
    }
  }
}
