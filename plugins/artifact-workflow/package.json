{
  "name": "artifact-workflow",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run check && node scripts/build.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "check:dist": "node scripts/build.ts --check && node scripts/node-runtime.ts --verify",
    "runtime:verify": "node scripts/node-runtime.ts --verify",
    "runtime:update": "node scripts/node-runtime.ts --update",
    "clean:test": "node scripts/clean-test.ts",
    "lint": "oxlint --type-aware --deny-warnings mcp/src test scripts",
    "format": "prettier --write \"mcp/src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" .oxlintrc.json package.json tsconfig.json tsconfig.scripts.json .prettierrc.json \"../../.github/workflows/artifact-workflow-ci.yml\"",
    "format:check": "prettier --check \"mcp/src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" .oxlintrc.json package.json tsconfig.json tsconfig.scripts.json .prettierrc.json \"../../.github/workflows/artifact-workflow-ci.yml\"",
    "test": "npm run check:dist && npm run clean:test && tsc && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
